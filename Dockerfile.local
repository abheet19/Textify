FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 \
    TEXTIFY_EMBEDDING_PROVIDER=local TEXTIFY_LOCAL_MODEL_PATH=/opt/textify-model \
    HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements.txt requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements-local.txt
# Download once at build time, pinned to an immutable model revision.
RUN HF_HUB_OFFLINE=0 python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='qdrant/bge-small-en-v1.5-onnx-q', revision='52398278842ec682c6f32300af41344b1c0b0bb2', allow_patterns=['config.json','model_optimized.onnx','special_tokens_map.json','tokenizer_config.json','tokenizer.json'], local_dir='/opt/textify-model')"
COPY app ./app
# Build-time Linux smoke: actual model + web imports, no DB or hosted API call.
RUN python -c "import resource; from app.main import app; from app.local_embeddings import local_embed; v=local_embed(['A learner checks a document before trusting an answer.']); rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024; print({'dimensions':len(v[0]),'linux_peak_rss_mib':round(rss,1)}); assert len(v[0])==384; assert rss<384, 'Model smoke exceeds memory allowance'"
RUN useradd --create-home --uid 10001 textify
USER textify
# One web worker and one inference at a time for the 512 MiB machine.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --limit-concurrency 20"]
