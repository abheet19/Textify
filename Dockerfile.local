FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TEXTIFY_REQUIRE_ACCESS_CODE=1 \
    PORT=8080 \
    TEXTIFY_EMBEDDING_PROVIDER=local \
    TEXTIFY_LOCAL_MODEL_PATH=/opt/textify-model \
    HF_HUB_OFFLINE=1 \
    OMP_NUM_THREADS=1

WORKDIR /app
COPY requirements.txt requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements-local.txt

# Download the quantized model once at build time from an immutable revision.
RUN HF_HUB_OFFLINE=0 python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='qdrant/bge-small-en-v1.5-onnx-q', revision='52398278842ec682c6f32300af41344b1c0b0bb2', allow_patterns=['config.json','model_optimized.onnx','special_tokens_map.json','tokenizer_config.json','tokenizer.json'], local_dir='/opt/textify-model')"

COPY app ./app

# This is an actual model inference and a small semantic-ordering assertion.
RUN python -c "import resource; from app.main import app; from app.local_embeddings import local_embed; passages=['Photosynthesis converts light energy into chemical energy in plants.','A database index speeds up row lookup.']; query=local_embed(['How do plants store energy from sunlight?'], query=True)[0]; vectors=local_embed(passages); scores=[sum(a*b for a,b in zip(query, vector)) for vector in vectors]; rss=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024; print({'dimensions':len(query),'semantic_scores':[round(score,4) for score in scores],'linux_peak_rss_mib':round(rss,1)}); assert len(query)==384; assert scores[0]>scores[1]; assert rss<384, 'Model smoke exceeds memory allowance'"

RUN groupadd --gid 10001 textify \
    && useradd --uid 10001 --gid textify --create-home --home-dir /home/textify \
        --shell /usr/sbin/nologin textify

# Keep revision-only metadata after the pinned model and inference smoke layers.
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/abheet19/Textify" \
      org.opencontainers.image.revision="${VCS_REF}"
ENV TEXTIFY_RELEASE_SHA="${VCS_REF}"
USER textify:textify

# One web worker and one inference at a time for the 512 MiB machine.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --limit-concurrency 20"]
